{
  "compilerOptions": {
    "target": "ES2022",                          /* Output JavaScript version */
    "module": "NodeNext",                        /* Modern module support (ESM/CJS) */
    "moduleResolution": "NodeNext",
    "declaration": true,                         /* Generate .d.ts files for library types */
    "declarationMap": true,                      /* Map type declaration files to facilitate debugging */
    "outDir": "./dist",                          /* Output directory */
    "rootDir": "./src",                          /* Source root directory */
    "strict": true,                              /* Enable all strict type-checking options */
    "esModuleInterop": true,                     /* Compatibility with CommonJS modules */
    "skipLibCheck": true,                        /* Skip type checking of declaration files for speed */
    "forceConsistentCasingInFileNames": true,     /* Ensure that casing is correct in imports */
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*"]                        /* Compile only files in src */
}
